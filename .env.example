# Copiaza acest fisier in ".env" si completeaza datele.
# .env NU se urca pe GitHub (este in .gitignore).

IG_USERNAME=contul_tau
IG_PASSWORD=parola_ta

# Optional: secretul din aplicatia de autentificare (Google Authenticator etc).
# Daca il pui, botul genereaza singur codul 2FA si se poate reloga fara tine.
IG_TOTP_SECRET=

# Porneste automat, fara sa scrii "start"
IG_AUTO_START=1

# Mod server: nu cere nimic la tastatura (se seteaza singur cand nu ai terminal)
# IG_HEADLESS=1

# Unde se salveaza sesiunea, notitele si imaginile (util pe VPS/Docker)
# IG_DATA_DIR=/var/lib/instagram-bot
